    m_Localized: Garden
    m_Metadata:
      m_Items: []
  - m_Id: 68878059270144
    m_Localized: 'Friends: {count}'
    m_Metadata:
      m_Items:
      - rid: 4979853656306483282
  - m_Id: 68878059270145
    m_Localized: 'No friends yet.

      Rescue pugs in Adventure or Stroll!'
    m_Metadata:
      m_Items: []
  - m_Id: 68878059270146
    m_Localized: ???
