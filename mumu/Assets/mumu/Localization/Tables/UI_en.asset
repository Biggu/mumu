    m_Metadata:
      m_Items:
      - rid: 4979853656306483282
  - m_Id: 94519567675395
    m_Localized: 'You need {bone} more bones.

      Collect them on walks and adventures!'
    m_Metadata:
      m_Items:
      - rid: 4979853656306483282
