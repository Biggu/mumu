  - m_Id: 76568915439616
    m_Localized: Stroll {num}/{total}
    m_Metadata:
      m_Items:
      - rid: 4979853656306483282
  - m_Id: 76568944799744
    m_Localized: No more pug chances today
    m_Metadata:
      m_Items: []
  - m_Id: 76568944799745
    m_Localized: 'You used today''s 5 strolls.

      From now on, strolls won''t
      have pugs to rescue.

      Come back tomorrow for 5 more chances!'
    m_Metadata:
      m_Items: []
